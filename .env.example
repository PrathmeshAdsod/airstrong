# Browser-visible configuration. Never place secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_GITHUB_URL=https://github.com/PrathmeshAdsod/airstrong
# Leave blank locally to stream through the same-origin Next.js proxy. In production,
# this may be the public airline service URL after its origin allowlist is configured.
NEXT_PUBLIC_AIRSTRONG_EVENTS_BASE_URL=

# Server-only sponsor integration secrets. Never prefix these with NEXT_PUBLIC.
GEMINI_API_KEY=
DAYTONA_API_KEY=

# Local compatibility stack defaults.
TRUEFORGE_BASE_URL=http://localhost:8790
AIRSTRONG_DATABASE_URL=postgresql://airstrong:local-airstrong-only@localhost:5433/airstrong
AIRSTRONG_COMPATIBILITY_STATE_PATH=.airstrong/compatibility-state.json
# Internal runtime-to-airline bearer token. Use a long random secret outside local development.
AIRSTRONG_RUNTIME_TOKEN=
AIRSTRONG_AIRLINE_BASE_URL=http://localhost:4200
AIRSTRONG_AIRLINE_MCP_URL=http://host.docker.internal:4200/mcp
AIRSTRONG_RUNTIME_BASE_URL=http://localhost:4300
AIRSTRONG_WEB_ORIGINS=http://localhost:3000
